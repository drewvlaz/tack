{
  "name": "fashion-mood",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "concurrently -n web,worker -c blue,magenta \"pnpm dev:web\" \"pnpm dev:worker\"",
    "dev:web": "pnpm --filter @fashion-mood/web run dev",
    "dev:worker": "pnpm --filter @fashion-mood/worker run dev",
    "build": "pnpm --filter @fashion-mood/web run build",
    "build:web": "pnpm --filter @fashion-mood/web run build",
    "preview": "pnpm --filter @fashion-mood/web run preview",
    "lint": "pnpm -r --if-present run lint",
    "lint:web": "pnpm --filter @fashion-mood/web run lint",
    "lint:worker": "pnpm --filter @fashion-mood/worker run lint",
    "test": "pnpm -r --if-present run test",
    "test:web": "pnpm --filter @fashion-mood/web run test",
    "test:worker": "pnpm --filter @fashion-mood/worker run test",
    "deploy": "pnpm --filter @fashion-mood/worker run deploy",
    "cf-typegen": "pnpm --filter @fashion-mood/worker run cf-typegen",
    "db:generate": "pnpm --filter @fashion-mood/worker run db:generate",
    "db:migrate": "pnpm --filter @fashion-mood/worker run db:migrate",
    "db:migrate:local": "pnpm --filter @fashion-mood/worker run db:migrate:local",
    "db:seed:local": "pnpm --filter @fashion-mood/worker run db:seed:local",
    "db:studio": "pnpm --filter @fashion-mood/worker run db:studio",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,css,json,md}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript-eslint": "^8.60.1"
  }
}
