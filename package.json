{
  "name": "fashion-mood",
  "private": true,
  "workspaces": [
    "web",
    "worker"
  ],
  "scripts": {
    "dev": "concurrently -n web,worker -c blue,magenta \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:web": "npm run dev -w web --",
    "dev:worker": "npm run dev -w worker --",
    "build": "npm run build -w web --",
    "build:web": "npm run build -w web --",
    "preview": "npm run preview -w web --",
    "lint": "npm run lint --workspaces --if-present",
    "lint:web": "npm run lint -w web --",
    "lint:worker": "npm run lint -w worker --",
    "test": "npm run test --workspaces --if-present",
    "test:web": "npm run test -w web --",
    "test:worker": "npm run test -w worker --",
    "deploy": "npm run deploy -w worker --",
    "cf-typegen": "npm run cf-typegen -w worker --",
    "db:generate": "npm run db:generate -w worker --",
    "db:migrate": "npm run db:migrate -w worker --",
    "db:migrate:local": "npm run db:migrate:local -w worker --",
    "db:seed:local": "npm run db:seed:local -w worker --",
    "db:studio": "npm run db:studio -w worker --",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,css,json,md}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript-eslint": "^8.60.1"
  }
}
