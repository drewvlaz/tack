{
  "name": "tack",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": "24.7.0"
  },
  "scripts": {
    "dev": "concurrently -n web,worker -c blue,magenta \"pnpm dev:web\" \"pnpm dev:worker\"",
    "dev:web": "pnpm --filter @tack/web run dev",
    "dev:worker": "pnpm --filter @tack/worker run dev",
    "build": "pnpm --filter @tack/web run build",
    "build:web": "pnpm --filter @tack/web run build",
    "build:staging": "pnpm --filter @tack/web run build:staging",
    "build:production": "pnpm --filter @tack/web run build:production",
    "preview": "pnpm --filter @tack/web run preview",
    "lint": "pnpm -r --if-present run lint",
    "lint:web": "pnpm --filter @tack/web run lint",
    "lint:worker": "pnpm --filter @tack/worker run lint",
    "test": "pnpm -r --if-present run test",
    "test:web": "pnpm --filter @tack/web run test",
    "test:worker": "pnpm --filter @tack/worker run test",
    "deploy": "pnpm --filter @tack/worker run deploy",
    "deploy:staging": "pnpm --filter @tack/worker run deploy:staging",
    "deploy:production": "pnpm --filter @tack/worker run deploy:production",
    "deploy:pages:staging": "pnpm build:staging && pnpm --filter @tack/worker exec wrangler pages deploy ../web/dist --project-name tack --branch main",
    "deploy:pages:production": "pnpm build:production && pnpm --filter @tack/worker exec wrangler pages deploy ../web/dist --project-name tack --branch production",
    "cf-typegen": "pnpm --filter @tack/worker run cf-typegen",
    "db:generate": "pnpm --filter @tack/worker run db:generate",
    "db:migrate:local": "pnpm --filter @tack/worker run db:migrate:local",
    "db:migrate:staging": "pnpm --filter @tack/worker run db:migrate:staging",
    "db:migrate:production": "pnpm --filter @tack/worker run db:migrate:production",
    "db:seed:local": "pnpm --filter @tack/worker run db:seed:local",
    "db:studio": "pnpm --filter @tack/worker run db:studio",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,css,json,md}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript-eslint": "^8.60.1"
  }
}
